<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device transfer (Android 12+). The meter keys stay on this phone:
   they are encrypted with a Keystore key that can't be copied.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="meter_keys.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="meter_keys.xml" />
    </device-transfer>
</data-extraction-rules>
